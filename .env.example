# IssueMate Configuration Example
MONGODB_URI=mongodb://127.0.0.1:27018/issuemate?directConnection=true
MONGODB_DB=issuemate

# MinIO / S3 Object Storage
MINIO_ENDPOINT=http://127.0.0.1:9100
MINIO_ACCESS_KEY=your_minio_access_key # pragma: allowlist secret
MINIO_SECRET_KEY=your_minio_secret_key # pragma: allowlist secret
MINIO_BUCKET=issuemate-files
MINIO_REGION=us-east-1

# Super Admin Gmail (Controls allowed_users whitelist & MCP tokens)
SUPER_ADMIN_EMAIL=admin@example.com

# Optional Google OAuth 2.0 (can also be configured via Web UI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change_this_session_secret_in_production # pragma: allowlist secret

NEXT_PUBLIC_APP_URL=http://localhost:3300
